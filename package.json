{
  "name": "dailydabble-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:hub": "npm run dev -w @dailydabble/hub -- --port 3100",
    "dev:agegaple": "npm run dev -w @dailydabble/agegaple -- --port 3103",
    "dev:doodle": "npm run dev -w @dailydabble/doodle -- --port 3102",
    "dev:admin": "npm run dev -w @dailydabble/admin -- --port 3101",
    "dev:yeardle": "npm run dev -w @dailydabble/yeardle -- --port 3104",
    "dev:moviedle": "npm run dev -w @dailydabble/moviedle -- --port 3105",
    "dev:equadle": "npm run dev -w @dailydabble/equadle -- --port 3106",
    "dev:sportle": "npm run dev -w @dailydabble/sportle -- --port 3107",
    "dev:all": "concurrently -n hub,agegaple,admin,doodle,yeardle,moviedle,equadle,sportle -c green,blue,cyan,yellow,white,red,magenta,blue \"npm run dev:hub\" \"npm run dev:agegaple\" \"npm run dev:admin\" \"npm run dev:doodle\" \"npm run dev:yeardle\" \"npm run dev:moviedle\" \"npm run dev:equadle\" \"npm run dev:sportle\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
