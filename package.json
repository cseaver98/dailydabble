{
  "name": "dailydabble-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @dailydabble/web -- --port 3100",
    "dev:admin": "npm run dev -w @dailydabble/admin -- --port 3101",
    "dev:all": "concurrently -n web,admin -c green,cyan \"npm run dev:web\" \"npm run dev:admin\"",
    "seed:moviedle-titles": "node scripts/seed-moviedle-title-library.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
