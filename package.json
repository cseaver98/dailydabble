{
  "name": "dailydabble-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:hub": "npm run dev -w @dailydabble/hub -- --port 3100",
    "dev:agegaple": "npm run dev -w @dailydabble/agegaple -- --port 3101",
    "dev:yelple": "npm run dev -w @dailydabble/yelple -- --port 3102",
    "dev:all": "concurrently -n hub,agegaple,yelple -c green,blue,magenta \"npm run dev:hub\" \"npm run dev:agegaple\" \"npm run dev:yelple\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
